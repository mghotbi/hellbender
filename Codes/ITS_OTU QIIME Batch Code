#!/bin/bash
#SBATCH --job-name=ITS_analysis
#SBATCH --output=ITS_analysis_output.log
#SBATCH --error=ITS_analysis_error.log
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --time=72:00:00
#SBATCH --mem=100G

###########################################
# ITS Analysis Pipeline for OTU
###########################################
 conda activate qiime2-amplicon-2023.9
 
 
# Primers
# 5'-GAACCWGCGGARGGATCA-3'
# 5'-GCTGCGTTCTTCATCGATGC-3'

# Create a manifest file for importing
#!/bin/bash

# Define the output file
output_file="manifest.tsv"

# Write the header to the output file
echo -e "sample-id\tforward-absolute-filepath\treverse-absolute-filepath" > $output_file

# Loop through all forward read files
for i in *R1*.fastq.gz; do
    # Extract the sample ID by removing the unwanted part
    sample_id="${i/_L001_R1_001.fastq.gz/}"

    # Define the forward and reverse file paths
    forward_filepath="$PWD/$i"
    reverse_filepath="$PWD/${i/_R1_001.fastq.gz/_R2_001.fastq.gz}"

    # Modify the sample ID by removing "_L001_R1_001" and "_L001_R2_001" for the reverse read
    sample_id="${sample_id/_S[0-9]*_L001_R1/}"
    
    # Write the sample ID and file paths to the output file
    echo -e "$sample_id\t$forward_filepath\t$reverse_filepath" >> $output_file
done

echo "Manifest file created: $output_file"


##### Import sequences with the manifest
qiime tools import \
  --type 'SampleData[PairedEndSequencesWithQuality]' \
  --input-path manifest.tsv \
  --output-path paired-end-demux.qza \
  --input-format PairedEndFastqManifestPhred33V2

# ITSXpress trimming
qiime itsxpress trim-pair-output-unmerged \
  --i-per-sample-sequences paired-end-demux.qza \
  --p-region ITS1 \
  --p-taxa F \
  --p-cluster-id 1.0 \
  --p-threads 28 \
  --o-trimmed trimmed_exact.qza

# Summarize demultiplexed sequences
qiime demux summarize \
  --i-data trimmed_exact.qza \
  --o-visualization reads_trimmed_summary.qzv

#  '04_denoise' 
qiime dada2 denoise-paired \
  --i-demultiplexed-seqs trimmed_exact.qza \
  --p-trunc-len-r 0 \
  --p-trunc-len-f 0 \
  --output-dir 04_denoise
  --p-n-threads 28



########VSEARCH

qiime vsearch cluster-features-de-novo --help

qiime vsearch cluster-features-de-novo \
  --i-table 04_denoise/table.qza \
  --i-sequences 04_denoise/representative_sequences.qza \
  --p-perc-identity 0.97 \
  --output-dir 05_clustered

  
  #############EXPORT
  
 
#!/bin/bash

# List files in the 05_clustered directory
echo "Files in 05_clustered directory:"
ls 05_clustered

# Export all QIIME artifacts (.qza files) in the 05_clustered directory
for i in 05_clustered/*.qza; do
    if [ -f "$i" ]; then
        echo "Exporting $i..."
        qiime tools export --input-path "$i" --output-path "${i%.qza}.export"
    fi
done

# Convert the feature table BIOM file to TSV format
if [ -f 05_clustered/clustered_table.export/feature-table.biom ]; then
    echo "Converting feature-table.biom to TSV..."
    biom convert -i 05_clustered/clustered_table.export/feature-table.biom -o 05_clustered/clustered_table.export/feature-table.biom.tsv --to-tsv
else
    echo "Error: clustered_table.export/feature-table.biom not found."
fi

# Display the first few lines of the exported stats.tsv file
if [ -f 05_clustered/clustered_denoising_stats.export/stats.tsv ]; then
    echo "Contents of stats.tsv:"
    head 05_clustered/clustered_denoising_stats.export/stats.tsv
else
    echo "stats.tsv not found."
fi

# Display the first few lines of the exported dna-sequences.fasta file
if [ -f 05_clustered/clustered_representative_sequences.export/dna-sequences.fasta ]; then
    echo "Contents of dna-sequences.fasta:"
    head 05_clustered/clustered_representative_sequences.export/dna-sequences.fasta
else
    echo "dna-sequences.fasta not found."
fi

# Count the number of sequences in dna-sequences.fasta
if [ -f 05_clustered/clustered_representative_sequences.export/dna-sequences.fasta ]; then
    echo "Number of sequences in dna-sequences.fasta:"
    grep -c ">" 05_clustered/clustered_representative_sequences.export/dna-sequences.fasta
else
    echo "dna-sequences.fasta not found."
fi

echo "Processing completed."



##############from here on Tabe changes to table-dn-99.qza and rep-seqs-dn-99.qza is the rep read

# Ensure the output directory exists

qiime feature-classifier classify-sklearn \
  --i-classifier unite-ver9-classifier-23.qza \
  --i-reads 05_clustered/clustered_sequences.qza \
  --output-dir 05_taxonomy

# Export taxonomy
qiime tools export \
  --input-path 05_taxonomy/classification.qza \
  --output-path 05_taxonomy/export
  
###################################################################OR
qiime feature-classifier classify-consensus-blast \
  --i-query rep-seqs-dn-98.qza \
  --i-reference-taxonomy "ver9_dynamic_25.07.2023-taxonomy.qza" \
  --i-reference-reads "ver9_dynamic_25.07.2023.qza" \
  --output-dir 05_taxonomy \
  --p-perc-identity 0.80 \
  --p-maxaccepts 1
  
qiime tools export \
  --input-path 05_taxonomy/classification.qza \
  --output-path export

cut -f2 05_taxonomy/export/taxonomy.tsv | sort | uniq -c | sort -n -r | head
#################

# Phylogenetic analysis
qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences 05_clustered/clustered_sequences.qza \
  --o-alignment aligned-rep-seqs.qza \
  --o-masked-alignment masked-aligned-rep-seqs.qza \
  --o-tree unrooted-tree.qza \
  --o-rooted-tree rooted-tree.qza


# Export tree
qiime tools export \
  --input-path rooted-tree.qza \
  --output-path exported_files


qiime taxa barplot \
 --i-table 05_clustered/clustered_table.qza \
 --i-taxonomy 05_taxonomy/classification.qza \
 --m-metadata-file metadata.txt \
 --o-visualization taxa-bar-plots.qzv

 
 
# Alpha rarefaction
qiime diversity alpha-rarefaction \
  --i-table 05_clustered/clustered_table.qza \
  --i-phylogeny rooted-tree.qza \
  --p-max-depth 20000 \
  --m-metadata-file metadata.txt \
  --o-visualization alpha-rarefaction.qzv



